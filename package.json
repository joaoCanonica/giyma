{
  "name": "giyma-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Site da Giyma Saúde e Estética Avançada · Dra. Ester Santos · farmacêutica esteta · CRF-SC 3984",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "predev": "node scripts/prepare-media.mjs && node scripts/gerar-og.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-media.mjs && node scripts/gerar-og.mjs",
    "build": "astro build",
    "postbuild": "node scripts/pos-build.mjs",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check .",
    "test": "vitest run && node scripts/test-config.mjs && node scripts/test-seo.mjs",
    "test:e2e": "node scripts/e2e-funil.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate-config": "node scripts/validate-config.mjs",
    "audit-compliance": "node scripts/audit-compliance.mjs",
    "audit-a11y": "node scripts/audit-a11y.mjs",
    "audit-lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit-seo": "node scripts/audit-seo.mjs",
    "audit-contraste": "node scripts/audit-contraste.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "capturar": "node scripts/capturar.mjs",
    "media:stills": "node scripts/extract-stills.mjs",
    "test-config": "node scripts/test-config.mjs",
    "audit": "pnpm audit-compliance && pnpm audit-seo && pnpm audit-csp && pnpm audit-a11y && pnpm audit-lighthouse",
    "audit-csp": "node scripts/audit-csp.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "astro-eslint-parser": "3.2.0",
    "axe-core": "4.11.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "fontkitten": "1.0.3",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "node-html-parser": "9.0.6",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
