---
// "Dra. Ester Santos · farmacêutica esteta · CRF-SC 3984" — sempre juntos (seção 8).
// O audit-compliance só aceita o nome dentro deste componente (data-assinatura-profissional).
import { profissional } from '../config/index.ts';

interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { as: Tag = 'p', class: classe } = Astro.props;
const p = profissional;
---

<Tag class:list={['assinatura-profissional', classe]} data-assinatura-profissional>
  <span class="nome">
    {p.tratamento.valor} {p.nome.valor}
  </span>
  <span aria-hidden="true"> · </span>
  <span class="profissao">{p.profissao.valor}</span>
  <span aria-hidden="true"> · </span>
  <span class="registro">{p.registro.valor}</span>
</Tag>
