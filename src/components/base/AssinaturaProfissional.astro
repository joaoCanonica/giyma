---
// "Dra. Ester Santos · farmacêutica esteta · CRF-SC 3984": sempre juntos (seção 8).
// O audit-compliance só aceita o nome dentro deste componente (data-assinatura-profissional).
import { profissional } from '../../config/index.ts';

interface Props {
  as?: 'p' | 'span' | 'div';
  /** linha: tudo em uma linha · bloco: nome grande, credenciais embaixo. */
  formato?: 'linha' | 'bloco';
  class?: string | undefined;
}
const { as: Tag = 'p', formato = 'linha', class: classe } = Astro.props;
const p = profissional;
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// Numa linha só, sem espaço entre os <span>: o "·" fica preso à palavra anterior (espaço não
// separável) e nunca abre a linha seguinte.
const sep = '<span class="ap-sep" aria-hidden="true">&nbsp;· </span>';
const interno =
  `<span class="ap-nome">${esc(`${p.tratamento.valor} ${p.nome.valor}`)}</span>${sep}` +
  `<span class="ap-profissao">${esc(p.profissao.valor)}</span>${sep}` +
  `<span class="ap-registro t-tabular">${esc(p.registro.valor)}</span>`;
---

<Tag
  class:list={['assinatura-profissional', `assinatura-profissional--${formato}`, classe]}
  data-assinatura-profissional
>
  <Fragment set:html={interno} />
</Tag>

<style is:global>
  .assinatura-profissional {
    margin: 0;
    font-size: var(--t-pequeno);
    color: var(--suave);
  }
  .assinatura-profissional .ap-nome {
    color: var(--texto);
  }
  .assinatura-profissional .ap-registro {
    letter-spacing: 0.04em;
  }
  /* Cada parte inteira: nunca "farmacêutica / esteta" nem "CRF-SC / 3984". */
  .assinatura-profissional .ap-nome,
  .assinatura-profissional .ap-profissao,
  .assinatura-profissional .ap-registro {
    white-space: nowrap;
  }
  .assinatura-profissional--bloco {
    display: grid;
    gap: 0.35rem;
  }
  .assinatura-profissional--bloco .ap-nome {
    font-family: var(--fonte-titulo);
    font-size: var(--t-2);
    line-height: 1.05;
  }
  .assinatura-profissional--bloco .ap-sep {
    display: none;
  }
  .assinatura-profissional--bloco .ap-profissao,
  .assinatura-profissional--bloco .ap-registro {
    font-family: var(--fonte-rotulo);
    font-size: var(--t-rotulo);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rotulo);
  }
</style>
