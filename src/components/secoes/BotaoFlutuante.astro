---
// Botão flutuante "Agendar" (só mobile). Some quando a seção "Agendar e visitar" está na tela
// (e no hero, que já tem o próprio botão). Glifo oficial do WhatsApp (o mesmo do Botao).
import { destino, microtextos } from './dados.ts';

const m = await microtextos();
const href = await destino('geral');
---

<a class="flutuante" href={href} data-flutuante>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    ></path>
  </svg>
  <span>{m.botoes['agendarFlutuante']}</span>
  <span class="so-leitor"> avaliação pelo WhatsApp</span>
</a>

<style>
  .flutuante {
    position: fixed;
    z-index: 50;
    right: var(--margem);
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 1.1rem;
    font-family: var(--fonte-rotulo);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-perola);
    background: var(--c-cacau);
    box-shadow: inset 0 0 0 1px var(--c-ouro);
    transition:
      opacity var(--d-2) var(--curva),
      transform var(--d-2) var(--curva);
  }
  .flutuante svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .flutuante[data-escondido] {
    opacity: 0;
    transform: translateY(1rem);
    pointer-events: none;
    visibility: hidden;
  }
  @media (min-width: 56rem) {
    .flutuante {
      display: none;
    }
  }
</style>

<script>
  const botao = document.querySelector<HTMLElement>('[data-flutuante]');
  const alvos = document.querySelectorAll('[data-agendar-secao], .hero');
  if (botao && alvos.length) {
    const visiveis = new Set<Element>();
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (e.isIntersecting) visiveis.add(e.target);
        else visiveis.delete(e.target);
      }
      botao.toggleAttribute('data-escondido', visiveis.size > 0);
    });
    alvos.forEach((a) => obs.observe(a));
  }
</script>
