---
// 7. Valores (pérola): composição assimétrica, 2 grandes + 2 pequenos, cada um com um still do tour.
import Imagem from '../base/Imagem.astro';
import Rotulo from '../base/Rotulo.astro';
import { fontePublica, microtextos, type Bloco } from './dados.ts';

interface Props {
  bloco: Bloco;
}
const { bloco } = Astro.props;
const m = await microtextos();
const STILL: Record<string, string> = {
  'seguranca-e-cuidado': 'still-consultorio',
  'naturalidade-com-proposito': 'still-recepcao',
  'etica-e-transparencia': 'still-placa',
  'acolhimento-humanizado': 'still-xicaras',
};
---

<section class="capitulo valores" data-superficie="perola" aria-labelledby="valores-titulo">
  <div class="contido">
    <header class="pilha valores-cabeca">
      <Rotulo>{bloco.rotulo}</Rotulo>
      <h2 id="valores-titulo" class="t-1">
        {bloco.titulo}
      </h2>
    </header>
    <ul class="valores-grade">
      {bloco.itens?.map((v, i) => {
        const still = STILL[v.id ?? ''] ?? 'still-consultorio';
        return (
          <li class:list={['valor', i < 2 ? 'valor--grande' : 'valor--pequeno', `valor--${i + 1}`]}>
            <div class="valor-foto fio-hover">
              <Imagem
                id={still}
                alt={m.alt[still] ?? ''}
                sizes={i < 2 ? '(min-width: 56rem) 40vw, 90vw' : '(min-width: 56rem) 20vw, 90vw'}
              />
            </div>
            <div class="valor-texto">
              <h3 class={i < 2 ? 't-2' : 't-3'}>{v.titulo}</h3>
              {v.citacao && (
                <blockquote class="valor-frase">
                  <p>{v.citacao.texto}</p>
                  <footer class="t-pequeno t-suave">
                    Ester Santos
                    {fontePublica(v.citacao.fonte) && ` · ${fontePublica(v.citacao.fonte)}`}
                  </footer>
                </blockquote>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .valores-cabeca {
    margin-bottom: var(--e-5);
  }
  .valores-grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-5) var(--e-4);
  }
  .valor {
    display: grid;
    gap: var(--e-2);
    align-content: start;
  }
  .valor-frase {
    margin: 0.6rem 0 0;
  }
  .valor-frase p {
    font-family: var(--fonte-acento);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.35;
  }
  .valor-frase footer {
    margin-top: 0.4rem;
  }
  .valor--pequeno {
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--e-3);
  }
  @media (min-width: 56rem) {
    .valores-grade {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .valor--1 {
      grid-column: 1 / span 5;
    }
    .valor--2 {
      grid-column: 7 / span 6;
      margin-top: var(--e-5);
    }
    .valor--3 {
      grid-column: 2 / span 5;
      align-self: start;
    }
    .valor--4 {
      grid-column: 8 / span 5;
      align-self: start;
      margin-top: var(--e-4);
    }
    .valor--pequeno {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }
</style>
