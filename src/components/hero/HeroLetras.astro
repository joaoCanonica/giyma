---
// Hero B (alternativa para comparar): o loop das letras douradas na parede petróleo em tela
// cheia, texto à frente. Sem atributo poster: o fundo é o LQIP (baixa entropia, o Chrome não o
// conta como LCP), então o LCP é o H1 e o vídeo nunca é o LCP. Mudo, só toca visível e sem
// movimento reduzido.
import { video } from '../base/midia.ts';
import HeroTexto from './HeroTexto.astro';

const vertical = video('loop-letras');
const variantes =
  (vertical as unknown as { variantes?: Record<string, typeof vertical> }).variantes ?? {};
const largo = variantes['loop-letras-16x9'];
const por = <T extends { largura: number }>(l: readonly T[], w: number) =>
  l.find((f) => f.largura === w) ?? l[0];
---

<section
  class="hero hero--letras"
  data-superficie="petroleo"
  aria-labelledby="hero-titulo"
  style={`--lqip:url("${vertical.poster.lqip}")`}
>
  <video
    class="hero-video"
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    data-hero-video
  >
    {largo && (
      <source src={largo.fontes.webm[0]?.src} type="video/webm" media="(min-width: 56rem)" />
    )}
    {largo && <source src={largo.fontes.mp4[0]?.src} type="video/mp4" media="(min-width: 56rem)" />}
    <source src={por(vertical.fontes.webm, 540)?.src} type="video/webm" />
    <source src={por(vertical.fontes.mp4, 540)?.src} type="video/mp4" />
  </video>
  <div class="hero-veu" aria-hidden="true"></div>
  <div class="hero-texto">
    <HeroTexto assinaturaNoDesktop={false} />
  </div>
</section>

<style is:global>
  .hero--letras {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--lqip) center / cover no-repeat;
  }
  .hero-video,
  .hero-veu {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Entra em fade quando começa a tocar: o primeiro quadro não vira candidato a LCP. */
  .hero-video {
    object-fit: cover;
    opacity: 0;
  }
  .hero-video[data-tocando] {
    opacity: 1;
    transition: opacity var(--d-4) var(--curva);
  }
  /* Véu chapado (sem degradê) para o texto passar AA sobre o dourado. */
  .hero-veu {
    background: color-mix(in srgb, var(--c-petroleo) 72%, transparent);
  }
  .hero--letras .hero-texto {
    position: relative;
    padding: 7rem var(--margem) var(--e-5);
  }
  @media (min-width: 56rem) {
    .hero--letras {
      align-items: center;
    }
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.addEventListener('playing', () => (v.dataset.tocando = ''), { once: true });
    v.play().catch(() => {});
  }
</script>
