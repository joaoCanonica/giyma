---
// Home. Sessão 4: só a entrada e o hero (o resto vem na sessão 6A).
import Documento from '../components/base/Documento.astro';
import Entrada from '../components/entrada/Entrada.astro';
import Cabecalho from '../components/hero/Cabecalho.astro';
import HeroRetrato from '../components/hero/HeroRetrato.astro';
---

<Documento
  titulo="Giyma Saúde e Estética Avançada · Lages/SC"
  descricao="Harmonização facial em Lages com a Dra. Ester Santos, farmacêutica esteta (CRF-SC 3984): avaliação individual e planejamento."
  superficie="cacau"
>
  <Entrada slot="inicio" />
  <div class="topo">
    <Cabecalho />
    <main>
      <HeroRetrato />
    </main>
  </div>
</Documento>
