---
// /privacidade: LGPD em linguagem simples.
import Provisorio from '../components/Provisorio.astro';
import { pagina, textoHtml } from '../components/secoes/dados.ts';
import Pagina from '../layouts/Pagina.astro';

const p = await pagina('privacidade');
const b = p.blocos;
const ORDEM = ['whatsapp', 'saude', 'externos', 'direitos', 'responsavel'];
---

<Pagina
  meta={p.meta}
  resposta={p.resposta}
  trilha="Privacidade"
  rotulo={b['resumo']?.rotulo}
  titulo={b['resumo']?.titulo ?? ''}
  abertura={b['resumo']?.paragrafos}
>
  <section class="capitulo" data-superficie="perola" aria-label="Política de privacidade">
    <div class="contido pv-lista">
      {ORDEM.flatMap((k) => (b[k] ? [b[k]] : [])).map((bl, i) => (
        <article class="pv-item">
          <span class="pv-num t-tabular" aria-hidden="true">
            {`0${i + 1}`}
          </span>
          <div class="pilha">
            <h2 class="t-2">{bl.titulo}</h2>
            {bl.paragrafos?.map((x) => (
              <p class="t-suave" set:html={textoHtml(x)} />
            ))}
            {bl.pendente && <Provisorio rotulo={bl.pendente} />}
          </div>
        </article>
      ))}
    </div>
  </section>
</Pagina>

<style>
  .pv-lista {
    display: grid;
    gap: var(--e-4);
    max-width: 52rem;
  }
  .pv-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--e-2);
    padding-top: var(--e-3);
    border-top: 1px solid color-mix(in srgb, var(--fio) 60%, transparent);
  }
  .pv-num {
    padding-top: 0.5rem;
    font-family: var(--fonte-rotulo);
    font-size: var(--t-rotulo);
    color: var(--rotulo);
  }
</style>
