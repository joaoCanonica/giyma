---
// Publica as páginas internas (noindex): o Astro não roteia arquivos que começam com "_".
import Estilo from './_estilo.astro';
import HeroA from './_hero-a.astro';
import HeroB from './_hero-b.astro';
import { modoAtual } from '../config/index.ts';

// Páginas internas (sistema de design, comparação de heroes) não vão para a produção.
export function getStaticPaths() {
  if (modoAtual() === 'producao') return [];
  return [
    { params: { interna: '_estilo' } },
    { params: { interna: '_hero-a' } },
    { params: { interna: '_hero-b' } },
  ];
}
const paginas = { _estilo: Estilo, '_hero-a': HeroA, '_hero-b': HeroB } as const;
const Pagina = paginas[Astro.params.interna as keyof typeof paginas];
---

<Pagina />
